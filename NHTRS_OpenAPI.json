  "components": {
    "schemas": {
      "GuestIn": {
        "properties": {
          "citizenship": {
            "type": "string",
            "enum": [
              "nigerian",
              "foreign"
            ],
            "title": "Citizenship"
          },
          "full_name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Full Name"
          },
          "phone": {
            "type": "string",
            "maxLength": 35,
            "minLength": 6,
            "title": "Phone"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "nationality": {
            "type": "string",
            "maxLength": 70,
            "title": "Nationality",
            "default": "Nigeria"
          },
          "contact_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 250
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Address"
          },
          "occupation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Occupation"
          },
          "nin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nin"
          },
          "passport_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 35
              },
              {
                "type": "null"
              }
            ],
            "title": "Passport Number"
          },
          "passport_expiry": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passport Expiry"
          },
          "entry_basis": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "visa",
                  "visa_exempt",
                  "ecowas",
                  "residence_permit"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Basis"
          },
          "visa_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Visa Type"
          },
          "visa_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Visa Number"
          },
          "visa_expiry": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visa Expiry"
          },
          "residency_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "visitor",
                  "resident"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Residency Status"
          },
          "residency_permit_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Residency Permit Number"
          }
        },
        "type": "object",
        "required": [
          "citizenship",
          "full_name",
          "phone",
          "email"
        ],
        "title": "GuestIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "PropertyIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hotel",
              "guesthouse",
              "serviced_apartment",
              "short_let",
              "resort",
              "lodge",
              "hostel",
              "other"
            ],
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "city": {
            "type": "string",
            "maxLength": 90,
            "minLength": 2,
            "title": "City"
          },
          "total_units": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Total Units"
          }
        },
        "type": "object",
        "required": [
          "name",
          "kind",
          "state",
          "city",
          "total_units"
        ],
        "title": "PropertyIn"
      },
      "StayIn": {
        "properties": {
          "unit": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Unit"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "pms",
              "channel_manager",
              "airbnb_host"
            ],
            "title": "Source",
            "default": "manual"
          },
          "external_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "External Ref"
          },
          "guests": {
            "items": {
              "$ref": "#/components/schemas/GuestIn"
            },
            "type": "array",
            "maxItems": 25,
            "minItems": 1,
            "title": "Guests"
          }
        },
        "type": "object",
        "required": [
          "unit",
          "guests"
        ],
        "title": "StayIn"
      },
      "UserIn": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{3,60}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 12,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "national",
              "state",
              "property"
            ],
            "title": "Role"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "property_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Property Id"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "role"
        ],
        "title": "UserIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}